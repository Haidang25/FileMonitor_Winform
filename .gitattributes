# Chuan hoa ky tu xuong dong: tranh xung dot LF/CRLF khi lam viec tren Windows
* text=auto

# Tep ma nguon C#
*.cs      text diff=csharp
*.cshtml  text
*.md      text

# Tep du an / giai phap cua Visual Studio -> bat buoc CRLF
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.csproj  text eol=crlf
*.config  text eol=crlf
*.resx    text eol=crlf
*.settings text eol=crlf

# Tep nhi phan (khong dieu chinh, khong diff)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.dll  binary
*.exe  binary
